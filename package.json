{
  "name": "gregorys-awesome-teams",
  "version": "1.0.0",
  "private": true,
  "description": "Prompt, context and harness engineering kit for university teams building on the IBM Bob harness.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "gat-install": "./src/cli.mjs"
  },
  "scripts": {
    "install:kit": "node src/cli.mjs",
    "verify": "node src/cli.mjs --verify",
    "build:banner": "node tools/build-banner.mjs",
    "build:flow": "node tools/build-flow-diagram.mjs",
    "build:skills": "node tools/build-skills-diagram.mjs",
    "build:chain": "node tools/build-chain-diagram.mjs",
    "build:kit": "node tools/build-improve-prompt-kit.mjs",
    "build:cheatsheet": "node tools/build-cheatsheet.mjs",
    "build:svg": "npm run build:banner && npm run build:flow && npm run build:skills && npm run build:chain",
    "build:all": "npm run build:kit && npm run build:cheatsheet && npm run build:svg",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90",
    "lint:scripts": "bash scripts/lib/selfcheck.sh"
  },
  "license": "MIT"
}
